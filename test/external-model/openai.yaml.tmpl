# Purpose: Defines the opt-in OpenAI Chat Completions ExternalProvider and MaaS
# authorization chain without embedding a credential.
#
# Scope: Kind and OpenShift E2E resources only. This is not a production manifest.
#
# Dependencies: Requires an existing AITenant, MaaS API, controller, and the
# tenant-local Secret named by EXTERNAL_MODEL_OPENAI_SECRET. The platform
# harness must apply this file explicitly; it must never be included in a base
# manifest glob.
#
# Qualification role: Provides the normal ExternalProvider -> ExternalModel ->
# MaaSModelRef -> MaaSSubscription -> MaaSAuthPolicy path for a real OpenAI
# Chat Completions qualification. The Secret contains the credential; this file
# contains references only.

apiVersion: inference.opendatahub.io/v1alpha1
kind: ExternalProvider
metadata:
  name: openai
  namespace: "${EXTERNAL_MODEL_NAMESPACE}"
  labels: {external-model-e2e/run-id: "${EXTERNAL_MODEL_RUN_ID}"}
spec:
  provider: openai
  endpoint: api.openai.com
  auth:
    type: apikey
    secretRef:
      name: ${EXTERNAL_MODEL_OPENAI_SECRET}
---
apiVersion: inference.opendatahub.io/v1alpha1
kind: ExternalModel
metadata:
  name: openai-gpt-4o-mini
  namespace: "${EXTERNAL_MODEL_NAMESPACE}"
  labels: {external-model-e2e/run-id: "${EXTERNAL_MODEL_RUN_ID}"}
spec:
  modelName: gpt-4o-mini
  externalProviderRefs:
    - ref:
        name: openai
      targetModel: gpt-4o-mini
      apiFormat: openai-chat
      path: /v1/chat/completions
---
apiVersion: maas.opendatahub.io/v1alpha1
kind: MaaSModelRef
metadata:
  name: gpt-4o-mini
  namespace: "${EXTERNAL_MODEL_NAMESPACE}"
  labels: {external-model-e2e/run-id: "${EXTERNAL_MODEL_RUN_ID}"}
spec:
  modelRef:
    kind: ExternalModel
    name: openai-gpt-4o-mini
---
apiVersion: maas.opendatahub.io/v1alpha1
kind: MaaSSubscription
metadata:
  name: "${EXTERNAL_MODEL_OPENAI_SUBSCRIPTION}"
  namespace: "${EXTERNAL_MODEL_NAMESPACE}"
  labels: {external-model-e2e/run-id: "${EXTERNAL_MODEL_RUN_ID}"}
spec:
  owner:
    users: ["${EXTERNAL_MODEL_OPENAI_USER}"]
  modelRefs:
    - name: gpt-4o-mini
      namespace: "${EXTERNAL_MODEL_NAMESPACE}"
      tokenRateLimits:
        - limit: 10000
          window: 1m
  priority: 20
---
apiVersion: maas.opendatahub.io/v1alpha1
kind: MaaSAuthPolicy
metadata:
  name: "${EXTERNAL_MODEL_OPENAI_POLICY}"
  namespace: "${EXTERNAL_MODEL_NAMESPACE}"
  labels: {external-model-e2e/run-id: "${EXTERNAL_MODEL_RUN_ID}"}
spec:
  modelRefs:
    - name: gpt-4o-mini
      namespace: "${EXTERNAL_MODEL_NAMESPACE}"
  subjects:
    users: ["${EXTERNAL_MODEL_OPENAI_USER}"]
