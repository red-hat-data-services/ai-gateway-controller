# Minimal echo-backend llm-katan for the overlay e2e. Build with the local
# llm-katan checkout as context:
#
#   docker build -t llm-katan:e2e -f Containerfile.katan "$LLMKATAN_REPO"
#
# Core deps only (fastapi/uvicorn/click/pydantic) — transformers/vllm are
# optional extras the echo backend never imports.
FROM python:3.12-slim
COPY . /src
RUN pip install --no-cache-dir /src
EXPOSE 8000
CMD ["llm-katan", "--model", "echo-served", "--backend", "echo", "--providers", "anthropic", "--host", "0.0.0.0", "--port", "8000"]
